DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/the-offhand?sslmode=require
PAYLOAD_SECRET=your-secret-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AZURE_STORAGE_BASE_URL=https://<account>.blob.core.windows.net
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=media
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# Configure the same random value as Telegram's webhook secret_token.
TELEGRAM_WEBHOOK_SECRET_TOKEN=replace-with-a-random-telegram-webhook-secret
# Map exactly two numeric Telegram user IDs to their Payload user IDs.
TELEGRAM_USER_AUTHOR_MAP={"123456789":1,"987654321":2}
AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com
AZURE_FOUNDRY_DEPLOYMENT_NAME=your-chat-model-deployment
AZURE_FOUNDRY_API_KEY=replace-with-foundry-api-key
AZURE_SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_SPEECH_KEY=replace-with-speech-key
AZURE_SPEECH_LANGUAGE=en-GB
